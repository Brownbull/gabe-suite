{
  "version": 1,
  "target": "gustify",
  "says": "The §A2 goldens of docs/design/element-forms/amendment-1.md, entered by hand as data. mark: V verified in source · R read · P projected · U unknown until measured. check-goldens.py walks a built forms.json by each golden's `get` path and prints match · mismatch · missing. Nothing here is copied from a feed: a mismatch is a finding about the generator or about the golden, and both are read before either moves.",
  "goldens": [
    {"id": "envelope-version", "slice": "1", "mark": "V", "says": "the feed is version 2", "get": ["version"], "eq": 2},
    {"id": "envelope-head", "slice": "1", "mark": "V", "says": "the envelope carries the build's head", "get": ["head"], "exists": true},
    {"id": "mw-exempt-paths", "slice": "1", "mark": "P", "says": "EXEMPT_PATHS resolves to ('/healthz',) (rate_limit.py:40)", "get": ["middleware", "middleware:RateLimitMiddleware", "pass_through", {"where": {"kind": "exact-paths"}}, {"first": true}, "values"], "eq": ["/healthz"]},
    {"id": "mw-flag-expr", "slice": "1", "mark": "R", "says": "the flag arm expands to settings.rate_limit_enabled or settings.is_production (config.py:247-254)", "get": ["middleware", "middleware:RateLimitMiddleware", "pass_through", {"where": {"kind": "flag"}}, {"first": true}, "expr"], "eq": "not (settings.rate_limit_enabled or settings.is_production)"},
    {"id": "rate-exempt-on-endpoint", "slice": "1", "mark": "P", "says": "POST /setup/complete's rate block names /healthz exempt", "get": ["endpoints", "endpoint:POST /setup/complete", "rate", "exempt"], "eq": ["/healthz"]},
    {"id": "catch-trail-consent", "slice": "1", "mark": "V", "says": "ConsentRequiredError is translated at api/setup.py (409 consent required)", "get": ["endpoints", "endpoint:POST /setup/complete", "produced", {"where": {"status": 409, "detail": "consent required"}}, {"first": true}, "via"], "has": "ConsentRequiredError"},

    {"id": "two-429-rows", "slice": "2", "mark": "V", "says": "POST /setup/complete carries two 429 rows (sensitive and global)", "get": ["endpoints", "endpoint:POST /setup/complete", "produced", {"where": {"status": 429}}], "len": 2},
    {"id": "429-at-site", "slice": "2", "mark": "V", "says": "both 429 rows are raised at rate_limit.py:127", "get": ["endpoints", "endpoint:POST /setup/complete", "produced", {"where": {"status": 429}}, {"pluck": "at"}], "eq": ["apps/api/middleware/rate_limit.py:127", "apps/api/middleware/rate_limit.py:127"]},
    {"id": "precondition-key-400", "slice": "2", "mark": "V", "says": "the precondition key is None (api/setup.py:193) guards the 400", "get": ["endpoints", "endpoint:POST /setup/complete", "preconditions", {"where": {"pred": "key is None"}}, {"first": true}, "status"], "eq": 400},
    {"id": "ids-no-collisions", "slice": "2", "mark": "P", "says": "no id collides feed-wide", "get": ["ids", "collisions"], "eq": 0},

    {"id": "mw-order", "slice": "3a", "mark": "V", "says": "RateLimitMiddleware is registered 1, runs 1, of 3 (main.py:119-122)", "get": ["middleware", "middleware:RateLimitMiddleware", "order"], "eq": {"of": 3, "registered": 1, "runs": 1}},
    {"id": "mw-outer", "slice": "3a", "mark": "V", "says": "its outer neighbour is CORSMiddleware", "get": ["middleware", "middleware:RateLimitMiddleware", "outer"], "eq": "middleware:CORSMiddleware"},
    {"id": "mw-inner", "slice": "3a", "mark": "V", "says": "its inner neighbour is IdempotencyMiddleware", "get": ["middleware", "middleware:RateLimitMiddleware", "inner"], "eq": "middleware:IdempotencyMiddleware"},
    {"id": "indistinct-exits-fires", "slice": "3a", "mark": "R", "says": "one _throttled answers both limits — indistinct-exits fires on RateLimitMiddleware", "get": ["arm_findings", "kinds", {"where": {"id": "indistinct-exits"}}], "has": "RateLimitMiddleware"},
    {"id": "dep-subdeps-order", "slice": "3a", "mark": "R", "says": "get_auth_context resolves bearer_scheme, get_session, _resolve_verifier in parameter order", "get": ["dependencies", "apps/api/auth/context.py::get_auth_context", "subdeps"], "eq": ["apps/api/auth/context.py::bearer_scheme", "apps/api/db.py::get_session", "apps/api/auth/context.py::_resolve_verifier"]},
    {"id": "dep-401-invalid-token", "slice": "3a", "mark": "V", "says": "its own 401 says invalid token", "get": ["dependencies", "apps/api/auth/context.py::get_auth_context", "exits", {"where": {"status": 401}}, {"pluck": "detail"}], "has": "invalid token"},
    {"id": "get-session-teardown", "slice": "3a", "mark": "V", "says": "db.py::get_session is teardown and commits nothing (db.py:51-54)", "get": ["dependencies", "apps/api/db.py::get_session", "teardown"], "eq": true},
    {"id": "dependency-commits-fires", "slice": "3a", "mark": "R", "says": "dependency-commits fires on get_auth_context (the auth commit at :79)", "get": ["arm_findings", "kinds", {"where": {"id": "dependency-commits"}}], "has": "get_auth_context"},

    {"id": "return-site", "slice": "3b", "mark": "V", "says": "the handler returns at api/setup.py:204", "get": ["endpoints", "endpoint:POST /setup/complete", "returns", {"where": {"kind": "return"}}, {"first": true}, "at"], "eq": "apps/api/api/setup.py:204"},
    {"id": "return-after-key", "slice": "3b", "mark": "P", "says": "that return is after not (key is None)", "get": ["endpoints", "endpoint:POST /setup/complete", "returns", {"where": {"kind": "return"}}, {"first": true}, "after"], "eq": ["not (key is None)"]},
    {"id": "branches-three", "slice": "3b", "mark": "P", "says": "complete_setup is the one deciding callee, with three arms", "get": ["endpoints", "endpoint:POST /setup/complete", "branches"], "len": 3},
    {"id": "branch-site", "slice": "3b", "mark": "V", "says": "every branch is read at the call site api/setup.py:196", "get": ["endpoints", "endpoint:POST /setup/complete", "branches", {"pluck": "site"}], "eq": ["apps/api/api/setup.py:196", "apps/api/api/setup.py:196", "apps/api/api/setup.py:196"]},
    {"id": "branch-why", "slice": "3b", "mark": "P", "says": "the site decides because it contributes rows and its arms differ in a commit", "get": ["endpoints", "endpoint:POST /setup/complete", "branches", {"pluck": "why"}], "has": ["contributes-rows", "commit-differs"]},
    {"id": "collapsed-calls", "slice": "3b", "mark": "P", "says": "get_idempotency_key and _me_response_from_result collapse (one return each)", "get": ["endpoints", "endpoint:POST /setup/complete", "collapsed", {"pluck": "call"}], "eq": ["get_idempotency_key", "_me_response_from_result"]},
    {"id": "healthz-429-inapplicable", "slice": "3b", "mark": "V", "says": "GET /healthz carries the global 429 with applies false (D19)", "get": ["endpoints", "endpoint:GET /healthz", "produced", {"where": {"status": 429}}, {"first": true}, "applies"], "eq": false},

    {"id": "422-cases-41", "slice": "4", "mark": "P", "says": "the body's 422 row carries 41 defined cases", "get": ["endpoints", "endpoint:POST /setup/complete", "produced", {"where": {"status": 422, "code": "pydantic error type"}}, {"first": true}, "cases", {"where_not": {"state": "default"}}], "len": 41},
    {"id": "422-units-allowed", "slice": "4", "mark": "V", "says": "household_format.units allows metric and imperial (constants.py:17)", "get": ["endpoints", "endpoint:POST /setup/complete", "produced", {"where": {"status": 422, "code": "pydantic error type"}}, {"first": true}, "cases"], "has": ["metric", "imperial"]},
    {"id": "422-extra-forbidden", "slice": "4", "mark": "V", "says": "the body forbids extra keys (schemas/setup.py:24)", "get": ["endpoints", "endpoint:POST /setup/complete", "produced", {"where": {"status": 422, "code": "pydantic error type"}}, {"first": true}, "cases"], "has": "extra_forbidden"},

    {"id": "switch-binding-impls", "slice": "5a", "mark": "V", "says": "the TokenVerifier port binds Firebase or Mock", "get": ["endpoints", "endpoint:POST /setup/complete", "switches", {"first": true}, "branches", {"pluck": "impl"}], "eq": ["FirebaseTokenVerifier", "MockTokenVerifier"]},
    {"id": "switch-changes-exit", "slice": "5a", "mark": "V", "says": "both implementations raise InvalidTokenError, so the switch changes no exit", "get": ["endpoints", "endpoint:POST /setup/complete", "switches", {"first": true}, "changes_exit"], "eq": false},

    {"id": "paths-count", "slice": "5b", "mark": "P", "says": "POST /setup/complete has 14 paths (the 13 drawn rows, the body-parse pair split)", "get": ["endpoints", "endpoint:POST /setup/complete", "paths"], "len": 14},
    {"id": "path-500-partial", "slice": "5b", "mark": "P", "says": "the 500 path is partial (a pass-through raise it cannot place)", "get": ["endpoints", "endpoint:POST /setup/complete", "paths", {"where": {"status": 500}}, {"first": true}, "state"], "eq": "partial"},

    {"id": "auth-commit-site", "slice": "6", "mark": "V", "says": "the auth commit is auth/context.py:79 and provisions users", "get": ["endpoints", "endpoint:POST /setup/complete", "auth", "provisions", {"first": true}, "committed_at"], "eq": "apps/api/auth/context.py:79"},
    {"id": "claim-race-handled", "slice": "6", "mark": "V", "says": "the idempotency claim catches its IntegrityError — race handled", "get": ["endpoints", "endpoint:POST /setup/complete", "repeat", "claims", {"first": true}, "race"], "eq": "handled"},
    {"id": "pantry-reset-race-uncaught", "slice": "6", "mark": "V", "says": "POST /pantry/reset/apply has no IntegrityError catch — race uncaught", "get": ["endpoints", "endpoint:POST /pantry/reset/apply", "repeat", "claims", {"first": true}, "race"], "eq": "uncaught"},

    {"id": "race-500-two", "slice": "7", "mark": "V", "says": "gustify has two race-500 endpoints (pantry reset, cooking sessions)", "get": ["arms", "contract", "stats", "findings", "race-500"], "eq": 2},
    {"id": "repeat-key-header", "slice": "7", "mark": "R", "says": "the idempotency key is the Idempotency-Key header", "get": ["endpoints", "endpoint:POST /setup/complete", "repeat", "key", "name"], "eq": "Idempotency-Key"},
    {"id": "rate-sensitive-limit", "slice": "7", "mark": "R", "says": "the sensitive limiter is 20 per window (config.py:139)", "get": ["endpoints", "endpoint:POST /setup/complete", "rate", "limits", {"first": true}, "args", {"where": {"param": "limit"}}, {"first": true}, "value"], "eq": 20},
    {"id": "k4-401-www-authenticate", "slice": "7", "mark": "R", "says": "the security 401 answers with WWW-Authenticate", "get": ["endpoints", "endpoint:POST /setup/complete", "responses", {"values": true}, {"where": {"status": 401, "source": "~security/http.py"}}, {"first": true}, "headers"], "has": "WWW-Authenticate"},

    {"id": "fn-complete-setup-raises", "slice": "8", "mark": "P", "says": "complete_setup raises SetupInProgressError and ConsentRequiredError", "get": ["functions", "apps/api/services/setup.py::complete_setup", "raises"], "has": ["SetupInProgressError", "ConsentRequiredError"]},
    {"id": "record-spend-swallows", "slice": "8", "mark": "P", "says": "record_spend's broad except returns normally — swallows-broad", "get": ["arm_findings", "kinds", {"where": {"id": "swallows-broad"}}], "has": "record_spend"},

    {"id": "c1048-proves-400", "slice": "9", "mark": "V", "says": "C1048 proves the 400 by status and detail", "get": ["endpoints", "endpoint:POST /setup/complete", "produced", {"where": {"status": 400}}, {"first": true}, "tests"], "has": "C1048"},
    {"id": "setup-act-calls", "slice": "9", "mark": "U", "says": "the act/arrange split of the 26 credited cases (designer said 12/14)", "get": ["endpoints", "endpoint:POST /setup/complete", "tests", "act"], "gte": 12},

    {"id": "pantryitem-drift-three", "slice": "10a", "mark": "V", "says": "PantryItem drifts on three columns", "get": ["models", "model:PantryItem", "drift"], "len": 3},
    {"id": "pantryitem-drift-columns", "slice": "10a", "mark": "V", "says": "they are created_at, unit_code and updated_at", "get": ["models", "model:PantryItem", "drift", {"pluck": "column"}], "eq": ["created_at", "unit_code", "updated_at"]},
    {"id": "pantry-reset-default-overridden", "slice": "10a", "mark": "R", "says": "PantryResetOperation's status default is overridden at pantry_reset.py:68", "get": ["models", "model:PantryResetOperation", "default_overridden"], "has": "in_progress"},
    {"id": "setting-env-name", "slice": "10b", "mark": "V", "says": "recipe_creation_enabled reads GUSTIFY_RECIPE_CREATION_ENABLED", "get": ["settings", "setting:recipe_creation_enabled", "env"], "eq": "GUSTIFY_RECIPE_CREATION_ENABLED"},
    {"id": "setting-verified-reader", "slice": "10b", "mark": "V", "says": "its verified reader includes api/recipe_creation.py:72", "get": ["settings", "setting:recipe_creation_enabled", "readers"], "has": "apps/api/api/recipe_creation.py:72"},
    {"id": "ai-credits-unbounded", "slice": "10b", "mark": "R", "says": "ai_credits_chef is an int with no bound — unbounded-number", "get": ["arm_findings", "short", {"where": {"id": "unbounded-number"}}], "has": "ai_credits_chef"},
    {"id": "mirror-unit-code-disagree", "slice": "10c", "mark": "P", "says": "unit_code's two schema defaults disagree (unit vs un)", "get": ["arm_findings", "short", {"where": {"id": "mirror-disagree"}}], "has": "unit_code"},

    {"id": "requiresetup-exits", "slice": "11a", "mark": "V", "says": "RequireSetup has four exits (two splashes, the redirect, the outlet)", "get": ["frontend", "pieces", "fe:apps/web/src/routes/RequireSetup.tsx#RequireSetup", "exits"], "len": 4},
    {"id": "requiresetup-k3-safe", "slice": "11a", "mark": "V", "says": "its router topology is safe", "get": ["frontend", "pieces", "fe:apps/web/src/routes/RequireSetup.tsx#RequireSetup", "k3", "state"], "eq": "safe"},
    {"id": "requiresetup-decided-by", "slice": "11a", "mark": "V", "says": "the redirect is decided by MeResponse.setup_required", "get": ["frontend", "pieces", "fe:apps/web/src/routes/RequireSetup.tsx#RequireSetup", "exits", {"where": {"kind": "nav"}}, {"first": true}, "decided_by", "field"], "eq": "setup_required"},
    {"id": "requiresetup-chain-rows", "slice": "11a", "mark": "V", "says": "seven chain rows for the drawn map's six paths", "get": ["frontend", "pieces", "fe:apps/web/src/routes/RequireSetup.tsx#RequireSetup", "chain"], "len": 7},
    {"id": "client-retry-4xx", "slice": "11b", "mark": "V", "says": "the client retries 0 on a 4xx — isClientError means status >= 400 and < 500", "get": ["frontend", "client", "clients", {"first": true}, "policy", "queries", "retry", "summary", "branches", {"first": true}, "means"], "eq": ["value.status >= 400", "value.status < 500"]},
    {"id": "client-mutations-no-retry", "slice": "11b", "mark": "V", "says": "mutations do not retry", "get": ["frontend", "client", "clients", {"first": true}, "policy", "mutations", "retry", "value"], "eq": false},
    {"id": "useme-invalidated-by-four", "slice": "11b", "mark": "V", "says": "useMe is invalidated by four mutations", "get": ["frontend", "pieces", "fe:apps/web/src/features/me/useMe.ts#useMe", "calls", {"first": true}, "invalidated_by"], "len": 4},
    {"id": "reason-collapsed-two", "slice": "11c", "mark": "V", "says": "two branches show one message for two refusals (SetupScreen 409, cookingSessionModel 409)", "get": ["arm_findings", "frontend", {"where": {"id": "reason-collapsed"}}], "len": 2},
    {"id": "reason-collapsed-setupscreen", "slice": "11c", "mark": "V", "says": "one of them is SetupScreen.tsx:43 on POST /setup/complete", "get": ["arm_findings", "frontend", {"where": {"id": "reason-collapsed"}}, {"pluck": "at"}], "has": "apps/web/src/features/auth/SetupScreen.tsx:43"},
    {"id": "dead-controls-pantry", "slice": "11d", "mark": "V", "says": "PantryStateViews :64, :65 and :107 are dead controls", "get": ["arm_findings", "frontend", {"where": {"id": "dead-control"}}, {"pluck": "at"}], "has": ["apps/web/src/features/pantry/components/PantryStateViews.tsx:64", "apps/web/src/features/pantry/components/PantryStateViews.tsx:65", "apps/web/src/features/pantry/components/PantryStateViews.tsx:107"]},
    {"id": "cleartoasts-uncalled", "slice": "11d", "mark": "V", "says": "useUiStore.clearToasts has no caller", "get": ["arm_findings", "frontend", {"where": {"id": "action-uncalled"}}, {"pluck": "action"}], "has": "clearToasts"},
    {"id": "optimistic-rollbacks", "slice": "11d", "mark": "V", "says": "all four optimistic mutations define a rollback", "get": ["arms", "frontend", "stats", "stores", "rollback", "defined"], "eq": 4},
    {"id": "setup-409-does", "slice": "11e", "mark": "V", "says": "on POST /setup/complete's 409 the client returns the text under auth.setup.error.in_progress — one row, a call handed back, its callee a parameter (SetupScreen :43)", "get": ["frontend", "reasons", "sites", {"where": {"at": "apps/web/src/features/auth/SetupScreen.tsx:43"}}, {"first": true}, "does"], "eq": [{"k": "call", "at": "apps/web/src/features/auth/SetupScreen.tsx:43", "callee": "t", "args": ["auth.setup.error.in_progress"], "from": "param", "class": "other", "returned": true}]},
    {"id": "cooking-403-literal", "slice": "11e", "mark": "V", "says": "on a 403 describeStartCookingError returns the literal cooking.error.start_allergen (cookingSessionModel :381 → :382)", "get": ["frontend", "reasons", "sites", {"where": {"at": "apps/web/src/features/cooking/cookingSessionModel.ts:381"}}, {"first": true}, "does", {"pluck": "literal"}], "eq": ["cooking.error.start_allergen"]},
    {"id": "require-setup-401-signout", "slice": "11e", "mark": "V", "says": "RequireSetup's 401 branch calls signOut from useAuth inside the effect, and the else arm's pushToast is not its row (:38–:41)", "get": ["frontend", "reasons", "sites", {"where": {"at": "apps/web/src/routes/RequireSetup.tsx:38"}}, {"first": true}, "does", {"pluck": "callee"}], "eq": ["signOut"]},
    {"id": "client-error-beyond-one-level", "slice": "11e", "mark": "V", "says": "isClientError hands both comparisons back to its caller — the state is beyond one level, never an empty branch (errors.ts :73)", "get": ["frontend", "reasons", "sites", {"where": {"at": "apps/web/src/lib/api/errors.ts:73"}}, {"pluck": "does_state"}], "eq": ["beyond one level", "beyond one level"]},
