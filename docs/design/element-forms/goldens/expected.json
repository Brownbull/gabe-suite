    {"id": "inflight-key-read-via", "slice": "12", "mark": "V", "says": "…through the handler's call at api/setup.py:191", "get": ["endpoints", "endpoint:POST /setup/complete", "inflight", {"where": {"kind": "state", "name": "idempotency_key"}}, {"first": true}, "read_at", {"pluck": "via"}], "has": "apps/api/api/setup.py:191"},
    {"id": "inflight-key-dies", "slice": "12", "mark": "V", "says": "a value on the request goes with the answer", "get": ["endpoints", "endpoint:POST /setup/complete", "inflight", {"where": {"kind": "state", "name": "idempotency_key"}}, {"first": true}, "dies"], "eq": "with the answer"},
