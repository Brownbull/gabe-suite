    {"id": "inflight-key-set-at", "slice": "12", "mark": "V", "says": "the repeat key is put on the request by IdempotencyMiddleware at middleware/idempotency.py:25", "get": ["endpoints", "endpoint:POST /setup/complete", "inflight", {"where": {"kind": "state", "name": "idempotency_key"}}, {"first": true}, "set_at"], "eq": "apps/api/middleware/idempotency.py:25"},
    {"id": "inflight-key-set-by", "slice": "12", "mark": "V", "says": "…by the middleware, not by the handler", "get": ["endpoints", "endpoint:POST /setup/complete", "inflight", {"where": {"kind": "state", "name": "idempotency_key"}}, {"first": true}, "set_by"], "eq": "middleware:IdempotencyMiddleware"},
    {"id": "inflight-key-from-header", "slice": "12", "mark": "V", "says": "its value comes from the Idempotency-Key header — read only on a mutating method (idempotency.py:23-24), so the row says the binding is conditional", "get": ["endpoints", "endpoint:POST /setup/complete", "inflight", {"where": {"kind": "state", "name": "idempotency_key"}}, {"first": true}, "from"], "eq": {"kind": "header", "name": "Idempotency-Key", "cond": true}},
